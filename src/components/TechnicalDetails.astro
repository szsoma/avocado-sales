---
import { getCollection } from 'astro:content';
import { getSite } from '../lib/content';
const topics = await getCollection('technical');
const site = await getSite();
---
<aside class="container technical-index" aria-label="Technical details and availability">
  {topics.map(topic => <div id={`technical-${topic.id}`} data-modal-source>
    <article class="technical-content"><p class="eyebrow">{topic.data.eyebrow}</p><h2 id={`technical-title-${topic.id}`}>{topic.data.title}</h2><p class="technical-intro">{topic.data.intro}</p>{topic.data.sections.map((section, i) => <section class="technical-section"><span class="technical-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3>{section.title}</h3><p>{section.body}</p>{section.code && <pre class="code-sample"><code>{section.code}</code></pre>}</div></section>)}</article>
  </div>)}
  <div id="early-access" data-modal-source><article class="technical-content availability"><p class="eyebrow">{site.name} / {site.status}</p><h2 id="availability-title">{site.availabilityTitle}</h2><p class="technical-intro">{site.availabilityIntro}</p><div class="availability-note"><span class="eyebrow">Availability</span><p>{site.availabilityNote}</p></div><a class="text-link" href="/workspace">{site.nav.find(link => link.href === '/workspace')?.label} <span aria-hidden="true">↗</span></a></article></div>
</aside>
