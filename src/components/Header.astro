---
import type { CollectionEntry } from 'astro:content';
import Logo from './Logo.astro';
import AccessLink from './AccessLink.astro';
interface Props { site: CollectionEntry<'site'>['data']; }
const { site } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="site-header"><div class="container header-inner">
  <a class="brand" href="/" aria-label={`${site.name} home`}><Logo />{site.name}</a>
  <nav class="desktop-nav" aria-label="Main navigation">{site.nav.map(link => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
  <div class="header-actions"><AccessLink site={site} small />
    <details class="mobile-menu"><summary><span class="menu-open">Menu</span><span class="menu-close">Close</span></summary><nav class="mobile-nav" aria-label="Mobile navigation">{site.nav.map(link => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}</nav></details>
  </div>
</div></header>
