---
import type { CollectionEntry } from 'astro:content';
import AccessLink from './AccessLink.astro';
interface Props { page: CollectionEntry<'pages'>['data']; site: CollectionEntry<'site'>['data']; home?: boolean; }
const { page, site, home = false } = Astro.props;
---
<section class:list={['hero', { 'subpage-hero': !home }]} aria-labelledby="page-heading"><p class="hero-badge">{site.alphaLabel}</p><p class="eyebrow">{page.eyebrow}</p><h1 id="page-heading">{page.headline}</h1><div class="hero-bottom"><p class="hero-intro">{page.intro}</p><div class="hero-actions"><AccessLink site={site} />{home && <a class="text-link" href="#workflow">{site.heroSecondaryLabel} <span aria-hidden="true">↓</span></a>}</div></div><p class="hero-status">{site.status}</p></section>
